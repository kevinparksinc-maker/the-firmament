function ordinal(n: number): string {
  const s = ['th','st','nd','rd'], v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
}

function getNakshatra(absoluteDegree: number | null): string | null {
  if (absoluteDegree === null || isNaN(absoluteDegree)) return null;
  const index = Math.floor((absoluteDegree % 360) / (360 / 27));
  return NAKSHATRA_SEQUENCE[index] ?? null;
}

function getChartRulers(natal: Record<string, PlanetPlacement>): string[] {
  const rulers: string[] = [];
  const sun = natal['Sun'];
  if (sun?.sign) { const r = SIGN_RULERS[sun.sign]; if (r) rulers.push(r); }
  const asc = natal['Asc'];
  if (asc?.sign) { const r = SIGN_RULERS[asc.sign]; if (r && !rulers.includes(r)) rulers.push(r); }
  return rulers;
}

function rulershipBoost(planet: string, chartRulers: string[]): number {
  return chartRulers.includes(planet) ? 1.4 : 1.0;
}

